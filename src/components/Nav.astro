---
import { events, featured } from '../data/site';

const ev = events[featured];
const links = [
  ['events', '#events'],
  ['about', '#about'],
  ['venue', '#venue'],
  ['faq', '#faq'],
  ['sponsors', '#sponsors'],
];
const canRegister = ev.status === 'open' && ev.registerUrl;
---

<nav class="nav" aria-label="Main">
  <div class="bar wrap">
    <a class="home" href="#top">~/hacked<span class="caret" aria-hidden="true">_</span></a>

    <ul class="links">
      {links.map(([label, href]) => <li><a href={href}>{label}</a></li>)}
    </ul>

    {
      canRegister ? (
        <a class="btn solid cta" href={ev.registerUrl} target="_blank" rel="noopener">
          register
        </a>
      ) : (
        <a class="btn cta" href="#events">
          <span class={`dot ${ev.status}`} /> {ev.month}
        </a>
      )
    }

    <details class="menu">
      <summary aria-label="Menu">menu</summary>
      <ul>
        {links.map(([label, href]) => <li><a href={href}>./{label}</a></li>)}
      </ul>
    </details>
  </div>
</nav>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    background: linear-gradient(rgb(3 6 6 / 0.85), rgb(3 6 6 / 0.6));
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 28px;
    height: 60px;
  }
  .home {
    color: var(--ink);
    font-weight: 800;
    font-size: 15px;
    text-decoration: none;
    margin-right: auto;
  }
  .caret {
    animation: blink 1s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  .links {
    display: flex;
    gap: 26px;
    padding: 0;
    list-style: none;
    font-size: 13px;
  }
  .links a,
  .menu a {
    color: var(--text);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .links a:hover,
  .menu a:hover {
    color: var(--ink);
  }
  .links a::before {
    content: './';
    color: var(--muted);
  }
  .cta {
    padding: 0.6em 0.95em;
    font-size: 13px;
  }

  .menu {
    display: none;
    position: relative;
  }
  .menu summary {
    list-style: none;
    padding: 8px 2px;
    font-size: 13px;
    color: var(--term);
    cursor: pointer;
  }
  .menu summary::-webkit-details-marker {
    display: none;
  }
  .menu summary::before {
    content: '[ ';
    color: var(--muted);
  }
  .menu summary::after {
    content: ' ]';
    color: var(--muted);
  }
  .menu ul {
    position: absolute;
    right: 0;
    top: calc(100% + 10px);
    min-width: 180px;
    margin: 0;
    padding: 10px 0;
    list-style: none;
    background: var(--panel);
    border: 1px solid var(--line-2);
  }
  .menu li a {
    display: block;
    padding: 9px 18px;
    font-size: 14px;
  }

  @media (max-width: 760px) {
    .links {
      display: none;
    }
    .menu {
      display: block;
    }
    .bar {
      gap: 14px;
    }
  }
</style>

<script>
  // close the mobile menu after picking a section
  const menu = document.querySelector<HTMLDetailsElement>('.nav .menu');
  menu?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) menu.open = false;
  });
</script>
